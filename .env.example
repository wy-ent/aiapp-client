# aiapp-mb runtime configuration example
# Copy to .env and edit; all items are optional and fall back to defaults if unset (the database defaults to local SQLite persistence).

# ===== Database connection (metadata persistence) =====
# Switch driver by prefix; if unset, defaults to a local SQLite file (sqlite://./data/aiapp.db, persisted):
#   PostgreSQL: postgres://user:pass@host:5432/dbname   (recommended for production)
#   SQLite   : sqlite://./data/aiapp.db                  (zero-dependency, file-as-database, auto-creates tables)
# Once configured, application metadata (apps / users / prompts) is persisted and survives restarts.
# DATABASE_URL=postgresql://aiapp@11.11.11:5432/aiapp
DATABASE_URL=sqlite://./data/aiapp.db

# ===== Artifact storage backend =====
# local (default, server-local directory) / cos (Tencent Cloud) / oss (Alibaba Cloud)
STORAGE_BACKEND=local
# local backend root directory (application artifacts such as wasm are written here; already ignored by .gitignore)
STORAGE_LOCAL_ROOT=./storage

# ===== Tencent Cloud COS (fill in when STORAGE_BACKEND=cos; supports URL presigning) =====
# The following are placeholders; replace with real credentials before going live (obtain from the console "Access Management -> API Keys").
# COS_SECRET_ID=replace-with-your-secret-id
# COS_SECRET_KEY=replace-with-your-secret-key
# COS_BUCKET=aiapp-1250000000        # bucket name, including the APPID suffix
# COS_REGION=ap-guangzhou            # region, e.g. ap-beijing / ap-shanghai / ap-guangzhou

# ===== Alibaba Cloud OSS (fill in when STORAGE_BACKEND=oss) =====
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=
