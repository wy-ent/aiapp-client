# Rust
/target
**/*.rs.bk

# MoonBit build artifacts
_build/
target/
.mooncakes/
.moonagent/

# Generated sample apps
/generated/

# Projects generated by the Web runtime (written when the service starts)
/generated_web/

# Unified storage backend (local mode) on-disk directory: app artifacts / build projects
/storage/

# Local SQLite metadata database (default location for DATABASE_URL=sqlite://...)
/data/

# Local environment variables (contain secrets, must not be committed)
.env

# Closed-source Pro / commercial middleware (pushed to a separate private repo, not this open-source repo)
/pro/

# Tauri container
crates/aiapp-container/node_modules/
crates/aiapp-container/frontend/node_modules/

# System
.DS_Store
