# aiapp-mb container deployment environment variable example
# Usage: copy to deploy.env and fill in real values, then run
#   docker compose --env-file deploy.env up -d --build

# ===== Database (metadata persistence) =====
# Defaults to the PostgreSQL service from docker-compose (recommended for production).
# You can also switch to local SQLite (zero external dependency): change DATABASE_URL to sqlite:///data/aiapp.db,
# and remove the dependency on the db service below (see the docker-compose.yml comments).
# DATABASE_URL selects the driver by prefix: postgres://... -> PostgreSQL; sqlite:///... -> SQLite file.
DATABASE_URL=postgres://aiapp:change-me-strong-password@db:5432/aiapp
# If using SQLite, comment out the PostgreSQL connection above and use the following line instead:
# DATABASE_URL=sqlite:///data/aiapp.db

# ===== PostgreSQL (only needed when DATABASE_URL points to the db service) =====
POSTGRES_USER=aiapp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aiapp

# ===== Web authentication (required; must be changed to a strong random value in production) =====
# AUTH_SECRET: JWT signing key; use a strong random value, e.g. `openssl rand -hex 32`
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# Initial admin account (written to the database on first startup; the password can later be changed in the admin panel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ===== AI backend (reserved; the web service currently has a built-in mock offline generator) =====
# The web service currently uses a built-in mock backend; the variables below are not yet consumed by the web
# service and are kept for later integration with a real OpenAI-compatible API.
AIAPP_BACKEND=mock
AIAPP_OPENAI_API_KEY=
AIAPP_OPENAI_BASE_URL=https://api.openai.com/v1
AIAPP_OPENAI_MODEL=gpt-4o-mini

# ===== Tencent Cloud COS object storage (fill in when STORAGE_BACKEND=cos; supports URL presigning) =====
# Placeholders; replace with real credentials before going live (obtain from the console "Access Management -> API Keys").
# COS_SECRET_ID=replace-with-your-secret-id
# COS_SECRET_KEY=replace-with-your-secret-key
# COS_BUCKET=aiapp-1250000000        # bucket name, including the APPID suffix
# COS_REGION=ap-guangzhou            # region
